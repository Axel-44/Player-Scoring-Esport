# ==============================================================================
# PULSE SCOUT - Backend Environment Variables (.env)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Path direktori artefak model (opsional, default: artifacts atau ../ml/artifacts)
ML_ARTIFACTS_DIR=artifacts

# Allowed CORS Origins (Pisahkan dengan koma)
# Cth: http://localhost:5173,https://pulse-scout.vercel.app
CORS_ORIGINS=*
